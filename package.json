{
  "name": "metr4202-robotics-lab",
  "private": true,
  "version": "1.0.0",
  "description": "Interactive study game for METR4202 Robotics & Automation (UQ)",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --dev --watch",
    "serve": "node scripts/serve.mjs",
    "test": "node scripts/test.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "smoke": "node scripts/smoke.mjs",
    "crawl": "node scripts/crawl.mjs",
    "check": "node scripts/typecheck.mjs && node scripts/test.mjs && node scripts/build.mjs"
  },
  "dependencies": {
    "katex": "0.16.11",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "@types/katex": "0.16.7",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "esbuild": "0.24.0",
    "playwright-core": "1.48.2",
    "typescript": "5.6.3"
  }
}
